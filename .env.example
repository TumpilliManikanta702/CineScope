# CineScope Environment Variables Configuration

# -------------------------------------------------------------
# BACKEND CONFIGURATION
# -------------------------------------------------------------
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local mongod)
# If left blank in development, CineScope automatically uses an embedded in-memory MongoDB!
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.dqsft9w.mongodb.net/cinescope?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_secure_random_secret_here
JWT_EXPIRES_IN=7d

# TMDB External Movie API Key (v3 auth)
# Get a free key at https://www.themoviedb.org/settings/api
# If not provided, CineScope automatically operates with its high-fidelity fallback catalog
TMDB_API_KEY=your_tmdb_api_key_here

# In-Memory Cache TTL (in seconds)
CACHE_TTL=600

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# -------------------------------------------------------------
# FRONTEND CONFIGURATION
# -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
